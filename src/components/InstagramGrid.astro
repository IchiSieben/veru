---
import { Image } from 'astro:assets';
import { img } from '../lib/images.js';
import { instagram } from '../lib/products.js';
---
<section class="section wrap" id="ofertas">
  <div class="sec-head r-up">
    <div>
      <p class="eyebrow" style="margin-bottom:.8rem">@veru.pe</p>
      <h2>Síguenos en <span class="it">Instagram</span></h2>
    </div>
    <a href="#" class="link-underline" style="margin-bottom:8px">@veru.pe</a>
  </div>
  <div class="ig-grid r-stag" id="ig">
    {instagram.map((file) => (
      <a class="ig" href="#" aria-label="Ver en Instagram">
        <Image src={img(file)} alt="Instagram VERÚ" widths={[200, 300, 500]} sizes="(max-width:560px) 33vw, 16vw" loading="lazy" />
        <div class="ig__ic"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="#fff" stroke="none"/></svg></div>
      </a>
    ))}
  </div>
</section>
