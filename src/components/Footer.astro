---
import BrandMark from './BrandMark.astro';
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <div class="brand" style="gap:.55rem">
          <BrandMark center="var(--ink)" />
          <span class="brand__word">Verú</span>
        </div>
        <p>Moda peruana en algodón pima. Diseñada y confeccionada en Lima, en ediciones limitadas para mujeres que visten lo que les dura.</p>
        <div class="footer__social">
          <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
          <a href="#" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M9 12a4 4 0 104 4V4c1 2 2.5 3 4.5 3"/></svg></a>
          <a href="#" aria-label="WhatsApp"><svg viewBox="0 0 24 24"><path d="M3 21l1.6-4A8 8 0 1112 20a8 8 0 01-4-1L3 21z"/></svg></a>
        </div>
      </div>
      <div class="fcol">
        <h4>Tienda</h4>
        <a href="/#nuevo">Novedades</a><a href="/#prendas">Vestidos</a>
        <a href="/#prendas">Tejidos</a><a href="/#prendas">Abrigos</a><a href="/#ofertas">Ofertas</a>
      </div>
      <div class="fcol">
        <h4>Ayuda</h4>
        <a href="#">Envíos y entregas</a><a href="#">Cambios y devoluciones</a>
        <a href="#">Guía de tallas</a><a href="#">Cuidado de prendas</a><a href="#">Contáctanos</a>
      </div>
      <div class="fcol">
        <h4>VERÚ</h4>
        <a href="/#marca">Nuestra historia</a><a href="/#marca">Algodón pima</a>
        <a href="#">Sostenibilidad</a><a href="#">Trabaja con nosotras</a>
      </div>
    </div>
    <div class="footer__bottom">
      <small>© 2026 VERÚ · Todos los derechos reservados</small>
      <div class="pays">
        <span class="pay">VISA</span><span class="pay">Mastercard</span>
        <span class="pay pay--yape">Yape</span><span class="pay pay--plin">Plin</span>
        <span class="pay">PayPal</span>
      </div>
      <span class="made">Hecho con orgullo en <b>Perú</b> ✶</span>
    </div>
  </div>
</footer>
